generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  hotel_id String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(255)
  address  String? @db.VarChar(255)
  city     String @db.VarChar(100)
  country  String @db.VarChar(100)
  timezone String @db.VarChar(50)

  roomTypes            RoomType[]
  cancellationPolicies CancellationPolicy[]
  physicalRooms        PhysicalRoom[]

  @@map("hotels")
}

model RoomType {
  room_type_id String   @id @default(uuid()) @db.Uuid
  hotel_id     String   @db.Uuid
  name         String   @db.VarChar(255)
  capacity     Int
  base_rate    Decimal  @db.Decimal(10, 2)
  amenities    String[] @db.VarChar(100)
  image_url    String?  @db.VarChar(500)

  hotel         Hotel          @relation(fields: [hotel_id], references: [hotel_id])
  physicalRooms PhysicalRoom[]

  @@map("room_types")
}

model CancellationPolicy {
  policy_id   String @id @default(uuid()) @db.Uuid
  hotel_id    String @db.Uuid
  name        String @db.VarChar(255)
  description String @db.Text

  hotel Hotel @relation(fields: [hotel_id], references: [hotel_id])

  @@map("cancellation_policies")
}

model PhysicalRoom {
  physical_room_id String   @id @default(uuid()) @db.Uuid
  hotel_id         String   @db.Uuid
  room_type_id     String   @db.Uuid
  room_number      String   @db.VarChar(20)
  available_from   DateTime @db.Date
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  hotel    Hotel    @relation(fields: [hotel_id], references: [hotel_id])
  roomType RoomType @relation(fields: [room_type_id], references: [room_type_id])

  @@unique([hotel_id, room_number])
  @@index([hotel_id, room_type_id])
  @@map("physical_rooms")
}

model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}
